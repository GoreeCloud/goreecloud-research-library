# GoreeCloud Research Library Development defaults
GORECLOUD_RESEARCH_DATA_DIR=./data
GORECLOUD_RESEARCH_MAX_FETCH_BYTES=5242880
GORECLOUD_RESEARCH_MAX_EXTRACT_CHARS=250000
GORECLOUD_RESEARCH_TIMEOUT_SECONDS=20
GORECLOUD_RESEARCH_MAX_REDIRECTS=5
GORECLOUD_RESEARCH_RESPECT_ROBOTS=true

# SECURITY: keep false on any deployment that can receive untrusted URLs.
GORECLOUD_RESEARCH_ALLOW_PRIVATE_FETCH=false

# Optional public fetch identity. Do not place secrets here.
# GORECLOUD_RESEARCH_USER_AGENT=GoreeCloudResearchLibrary/0.1 (+https://github.com/GoreeCloud/goreecloud-research-library)
